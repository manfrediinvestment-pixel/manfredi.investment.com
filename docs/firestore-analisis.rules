// Reglas de Firestore para los me gusta y comentarios de "Análisis e informes"
// (assets/analistas/social.js). Pegar este bloque en Firebase Console → Firestore
// → Reglas, DENTRO de `match /databases/{database}/documents { ... }`, junto a las
// reglas que ya existen (no reemplazar las de users/{uid}). Después: Publicar.
//
// Leer es libre. Dar me gusta y comentar exige cuenta iniciada.
// Cada uno borra sus comentarios; el creador puede borrar cualquiera.

    match /analisis/{pub}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['creado'])
        && request.resource.data.creado == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /analisis/{pub}/comentarios/{cid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'foto', 'texto', 'creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.foto is string && request.resource.data.foto.size() <= 500
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
        && request.resource.data.creado == request.time;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.token.email == 'nachito2502@gmail.com');
    }
